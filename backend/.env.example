# Security Settings
PROJECT_NAME="Solar Portfolio Intelligence & Autonomous Maintenance Platform"
API_V1_STR="/api"

# JWT Secret Key - Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secure-random-secret-key-here

# Token Expiry (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External API Integrations (NREL PVWatts)
# Register at https://developer.nrel.gov/signup/ to get an API key
PVWATTS_API_KEY=your-nrel-pvwatts-api-key

# Database Configuration
DATABASE_PATH=solar_intelligence.db

# Economics Configuration
DEFAULT_CURRENCY=₹
DEFAULT_CURRENCY_CODE=INR
